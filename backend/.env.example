# Copy this file to backend/.env and fill it in. Never commit backend/.env.

# Port the API listens on (the frontend expects 4000 unless you also set VITE_API_URL).
PORT=4000

# MongoDB connection string, e.g. from MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Leave it empty to run a temporary in-memory MongoDB (demo mode: seeded automatically,
# reset whenever the API restarts). On Atlas, allow your IP under Network Access
# (GitHub Codespaces needs 0.0.0.0/0).
MONGODB_URI=
MONGODB_DB=taskparty

# Secret used to sign login tokens. Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Browser origins allowed to call the API (comma-separated). The Codespaces-forwarded
# frontend URL (https://<codespace>-5173.app.github.dev) is added automatically.
CLIENT_ORIGIN=http://localhost:5173

# bcrypt cost factor (minimum 10).
BCRYPT_ROUNDS=12

# Load the demo users, parties and quests when the database is empty.
SEED_ON_EMPTY=true
